---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';

export interface Crumb {
  name: string;
  path: string;
}

export interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.path, SITE.url).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-[var(--color-muted)]">
  <ol class="flex flex-wrap gap-x-2 gap-y-1 list-none p-0 m-0">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index < items.length - 1 ? (
            <a href={item.path} class="no-underline hover:underline">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="font-medium">
              {item.name}
            </span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<JsonLd data={jsonLd} />
